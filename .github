name: Build Tweak

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Theos
      run: |
        git clone --recursive https://github.com/theos/theos.git $HOME/theos
        echo "THEOS=$HOME/theos" >> $GITHUB_ENV

    - name: Install dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y fakeroot ssh clang
        sudo apt-get install -y libssl-dev libxml2-dev

    - name: Download iOS SDK
      run: |
        cd $THEOS/sdks
        wget -q https://github.com/xybp888/iOS-SDKs/raw/master/iPhoneOS14.0.sdk.tar.gz
        tar xzf iPhoneOS14.0.sdk.tar.gz
        rm iPhoneOS14.0.sdk.tar.gz

    - name: Build
      run: |
        cd $GITHUB_WORKSPACE
        make package FINAL=yes

    - name: Upload dylib
      uses: actions/upload-artifact@v4
      with:
        name: ChinaMobileAdBlock-dylib
        path: |
          .theos/obj/debug/*.dylib
          packages/*.deb
